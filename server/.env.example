# ============================================
# SFI Queuing System - Socket.IO Server config
# Copy this file to server/.env and fill in
# your values. .env is git-ignored.
# ============================================

# Port the Socket.IO server listens on (default 4000)
PORT=4000

# Allowed browser origins for real-time connections.
# Use * for any origin (dev only) or list specific origins, e.g.:
# CORS_ORIGIN=http://localhost,http://localhost:80
CORS_ORIGIN=*

# Shared secret for the /emit endpoint. Must match EMIT_TOKEN
# in config/secrets.local.php. Empty = no token required (not recommended).
EMIT_TOKEN=change-me-to-a-long-random-string

# development | production
NODE_ENV=development
